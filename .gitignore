.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# dbt: the models come from contoso-data-product and are rendered from a
# manifest built at `make manifest`. Only the profiles are ours.
dbt/*/target/
dbt/*/logs/
dbt/*/dbt_packages/

# Where the platform mounts the product's outputs.
out/
product_snapshot.json
state.json

# `make show-product` stages the core's dbt projects here so they can be read
# without cloning contoso-data-product. Never edited, never committed: an
# edit here is a fork of the product that would be silently ignored.
product/
